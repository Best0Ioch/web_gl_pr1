const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;
attribute vec2 texCoord;
attribute vec3 tangent;

uniform mat4 ModelMatrix;
uniform mat4 ViewMatrix;
uniform mat4 ProjectionMatrix;
uniform mat3 NormalMatrix;
uniform vec2 uTextureScale;
uniform vec2 uPointPosition;

varying vec3 vNormal;
varying vec3 vWorldPos;
varying vec2 vTexCoord;
varying vec3 vTangent;
varying vec3 vBitangent;

void main() {
    vec4 worldPos = ModelMatrix * vec4(vertex, 1.0);
    vWorldPos = worldPos.xyz;
    
    // Gram-Schmidt orthogonalization 
    vec3 T = normalize(NormalMatrix * tangent);
    vec3 N = normalize(NormalMatrix * normal);
    T = normalize(T - dot(T, N) * N);
    vec3 B = cross(N, T);
    
    vNormal = N;
    vTangent = T;
    vBitangent = B;
    
    // Texture scaling around specified point
    vTexCoord = (texCoord - uPointPosition) * uTextureScale + uPointPosition;
    
    gl_Position = ProjectionMatrix * ViewMatrix * worldPos;
}
`;

// Fragment shader
const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif

varying vec3 vNormal;
varying vec3 vWorldPos;
varying vec2 vTexCoord;
varying vec3 vTangent;
varying vec3 vBitangent;

uniform vec3 uLightPosition;
uniform vec3 uViewPosition;
uniform vec3 uAmbientColor;
uniform float uShininess;
uniform bool uIsLight;

// Текстури
uniform sampler2D uDiffuseTexture;
uniform sampler2D uSpecularTexture;
uniform sampler2D uNormalTexture;

void main() {
    if (uIsLight) {
        gl_FragColor = vec4(1.0, 1.0, 1.0, 1.0);
    } else {
        // Normal mapping
        vec3 normalMap = texture2D(uNormalTexture, vTexCoord).rgb * 2.0 - 1.0;
        mat3 TBN = mat3(vTangent, vBitangent, vNormal);
        vec3 N = normalize(TBN * normalMap);
        
        vec3 L = normalize(uLightPosition - vWorldPos);
        vec3 V = normalize(uViewPosition - vWorldPos);
        vec3 R = reflect(-L, N);
        
        // Ambient
        vec3 ambient = uAmbientColor;
        
        // Diffuse 
        vec3 diffuseColor = texture2D(uDiffuseTexture, vTexCoord).rgb;
        float diff = max(dot(N, L), 0.0);
        vec3 diffuse = diffuseColor * diff;
        
        // Specular 
        float specularStrength = 1.0 - texture2D(uSpecularTexture, vTexCoord).r;
        float spec = 0.0;
        if (diff > 0.0) {
            spec = pow(max(dot(V, R), 0.0), uShininess);
        }
        vec3 specular = vec3(specularStrength) * spec;
        
        vec3 color = ambient + diffuse + specular;
        gl_FragColor = vec4(color, 1.0);
    }
}
`;